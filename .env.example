# ==============================================================================
# CUTLINE STUDIO — PRODUCTION CONFIGURATION TEMPLATE (.env.example)
# Approval-First Video Production Platform
# ==============================================================================
# IMPORTANT:
# - Do NOT commit your real .env.local file to Git.
# - The credentials in this template are illustrative placeholders.
# - Bootstrap secrets (Supabase, Vault Master Key, Cron Secret) are configured here.
# - Third-party provider keys (Gemini, PixVerse, YouTube) can also be entered
#   and tested directly through the encrypted in-app Integration Vault.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
# Canonical URL of the application. Used for OAuth redirects and PWA manifest.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION
# ------------------------------------------------------------------------------
# Public Supabase URL and anonymous client key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token

# Elevated server database key (SERVICE ROLE).
# NEVER expose this to the browser bundle. Only used in secure server routes/workers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Name of the private storage bucket for videos, audio stems, captions, and thumbnails
STORAGE_BUCKET_NAME=cutline-media

# ------------------------------------------------------------------------------
# 3. ENCRYPTED INTEGRATION VAULT (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte hex encryption key used to encrypt provider credentials stored in the DB.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. WORKER SCHEDULER & DURABLE QUEUE SECURITY
# ------------------------------------------------------------------------------
# Secret token required to invoke /api/cron/workers from Vercel Cron or an external runner.
# Calls without Authorization: Bearer <CRON_SECRET> are rejected with 401 Unauthorized.
CRON_SECRET=cutline_super_secret_cron_token_32chars_min

# Concurrency, lease duration, and retry policies
MAX_CONCURRENT_RENDERS=3
MAX_RENDER_RETRIES=3
WORKER_LOCK_DURATION_SEC=300
WORKER_HEARTBEAT_TIMEOUT_SEC=60

# ------------------------------------------------------------------------------
# 5. AI SCRIPTING & DIRECTION (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Google Gemini API Key. Can be set here as system default or in Integrations vault.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 6. VIDEO RENDERING PROVIDERS
# ------------------------------------------------------------------------------
# PixVerse v3 API key. Can be set here or in Integrations vault.
PIXVERSE_API_KEY=your_pixverse_api_key_here
PIXVERSE_API_URL=https://api.pixverse.ai

# Mock renderer protection:
# MUST be 'false' in production. When false, jobs will fail truthfully if no
# real video provider is available, preventing silent mock video output.
ALLOW_DEV_MOCK_RENDER=false

# ------------------------------------------------------------------------------
# 7. AUDIO & VOICE SYNTHESIS (ELEVENLABS)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 8. YOUTUBE DATA API & GOOGLE OAUTH
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Application credentials:
# Authorized redirect URI: http://localhost:3000/api/auth/youtube/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Default YouTube daily quota units (Google default is 10,000; video uploads cost 1,600)
DAILY_YOUTUBE_QUOTA_LIMIT=10000

# ------------------------------------------------------------------------------
# 9. MONITORING & OBSERVABILITY (OPTIONAL)
# ------------------------------------------------------------------------------
# Sentry DSN for production crash reporting and error capture
SENTRY_DSN=
